# Financial Chat is opt-in. Disabled or incomplete settings keep the backend
# running and make Financial Chat requests return a typed refusal.
FINANCIAL_CHAT_ENABLED=false
FINANCIAL_CHAT_MODEL_PROVIDER=anthropic
FINANCIAL_CHAT_MODEL_ID=claude-sonnet-5-5
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
FINANCIAL_CHAT_MODEL_MAX_RETRIES=2
FINANCIAL_CHAT_MODEL_TIMEOUT_MS=30000
