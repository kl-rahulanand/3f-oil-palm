# The four quality-gate commands; forge.toml's `test` runs the same scripts.
export FACTORY_STRUCTURAL_CMD="npm run structural"
export FACTORY_TYPECHECK_CMD="npm run typecheck"
export FACTORY_QUALITY_CMD="npm run quality"
# CI runs the declared hermetic list; `npm run test:db` is host evidence under D-0008.
export FACTORY_TEST_CMD="npm run test:hermetic"
