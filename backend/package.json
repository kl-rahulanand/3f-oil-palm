{
  "name": "@pulse/backend",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "ts-node -T src/main.ts",
    "start": "node dist/main.js",
    "db:migrate": "ts-node -T src/db/migrate.ts",
    "recon:run": "node --require ts-node/register src/recon/recon.run.ts",
    "test": "node --require ts-node/register --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@anatine/zod-openapi": "^2.2.6",
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/swagger": "^7.4.2",
    "@pulse/contract": "*",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.44.5",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.11.0",
    "node-sql-parser": "^5.3.1",
    "openapi3-ts": "^4.3.3",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
