  "views": {
    "public.actual_by_key_month": {
      "columns": {
        "plant": {
          "name": "plant",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "cost_center": {
          "name": "cost_center",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "gl_code": {
          "name": "gl_code",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "month": {
          "name": "month",
          "type": "date",
          "primaryKey": false,
          "notNull": true
        },
        "actual_net": {
          "name": "actual_net",
          "type": "numeric(18, 2)",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n  SELECT\n    txn.plant,\n    txn.cost_center,\n    txn.gl_code,\n    txn.month,\n    SUM(txn.debit - txn.credit)::numeric(18, 2) AS actual_net\n  FROM sap_transaction AS txn\n  INNER JOIN ingest_batch AS batch ON batch.id = txn.batch_id\n  WHERE batch.source_kind = 'actuals' AND batch.is_active\n  GROUP BY txn.plant, txn.cost_center, txn.gl_code, txn.month\n",
      "name": "actual_by_key_month",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    }
  },
