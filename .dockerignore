# Build-context hygiene: everything the image does not need, and everything it
# must NOT have. A developer .env carries real Bedrock credentials and must never
# enter a layer; deployment/ec2/.env.example is the only env file that may.
.env
.env.*
!deployment/ec2/.env.example

node_modules
**/node_modules
.next
**/.next
dist
**/dist

.git
.github
.factory
plans
docs
constitution
factory

**/*.test.ts
**/*.test.tsx
**/*.test.mjs
coverage
*.log
.DS_Store
