# Copy to deployment/ec2/.env on the EC2 box and fill in. That file is gitignored
# and must stay that way: it carries the Bedrock credentials.
#
#   cp deployment/ec2/.env.example deployment/ec2/.env
#   chmod 600 deployment/ec2/.env

# --- where the browser reaches the app -------------------------------------
# BOTH must be the EC2 instance's PUBLIC address, not localhost and not a
# container name: the browser resolves them, not the containers.
# NEXT_PUBLIC_API_BASE_URL is baked in at IMAGE BUILD time - change it and you
# must rebuild the frontend image, not just restart it.
NEXT_PUBLIC_API_BASE_URL=http://YOUR_EC2_PUBLIC_IP:4000
FRONTEND_ORIGIN=http://YOUR_EC2_PUBLIC_IP:3000

# Host ports, if 3000/4000 are taken on the instance.
# BACKEND_PORT=4000
# FRONTEND_PORT=3000

# --- auth -------------------------------------------------------------------
# Mock OTP: any listed user signs in with code 000000. This is why NODE_ENV is
# not "production" anywhere in the compose file - config.ts refuses to start a
# production build with mock OTP, and no real OTP transport is wired yet.
#
# The compose file sets BIND_HOST=0.0.0.0 so the backend is reachable at all.
# That means ANYONE who can reach port 3000 signs in as the admin. The security
# group is the only thing stopping them (decision 0029).
AUTH_OTP_MOCK=1
# Change this. It signs session tokens.
AUTH_JWT_SECRET=change-me-before-anyone-else-can-reach-this-box

# --- application database ---------------------------------------------------
PGUSER=threef
PGPASSWORD=change-me
PGDATABASE=threef

# --- warehouse database (a SEPARATE server, deliberately) -------------------
WAREHOUSE_PG_USER=warehouse
WAREHOUSE_PG_PASSWORD=change-me-too
WAREHOUSE_PG_DATABASE=warehouse

# --- assistant model --------------------------------------------------------
# Decision 0027 fixes Bedrock in ap-south-1. LLM_PROVIDER=mock will start, but
# the mock provider ALWAYS returns a clarification, so Ask will look broken.
LLM_PROVIDER=bedrock
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=
