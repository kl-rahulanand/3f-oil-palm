# Copy to deployment/ec2/.env on the EC2 box and fill in. That file is gitignored
# and must stay that way: it carries the Bedrock credentials.
#
#   cp deployment/ec2/.env.example deployment/ec2/.env
#   chmod 600 deployment/ec2/.env

# --- where the browser reaches the app -------------------------------------
# BOTH must be the EC2 instance's PUBLIC address, not localhost and not a
# container name: the browser resolves them, not the containers.
# NEXT_PUBLIC_API_BASE_URL is baked in at IMAGE BUILD time - change it and you
# must rebuild the frontend image, not just restart it.
NEXT_PUBLIC_API_BASE_URL=http://YOUR_EC2_PUBLIC_IP:4000
FRONTEND_ORIGIN=http://YOUR_EC2_PUBLIC_IP:3000

# Host ports, if 3000/4000 are taken on the instance.
# BACKEND_PORT=4000
# FRONTEND_PORT=3000

# --- auth -------------------------------------------------------------------
# Mock OTP: any listed user signs in with code 000000. This is why NODE_ENV is
# not "production" anywhere in the compose file - config.ts refuses to start a
# production build with mock OTP, and no real OTP transport is wired yet.
#
# The compose file sets BIND_HOST=0.0.0.0 so the backend is reachable at all.
# That means ANYONE who can reach port 3000 signs in as the admin. The security
# group is the only thing stopping them (decision 0029).
AUTH_OTP_MOCK=1
# Change this. It signs session tokens.
AUTH_JWT_SECRET=change-me-before-anyone-else-can-reach-this-box

# --- application database ---------------------------------------------------
PGUSER=threef
PGPASSWORD=change-me
PGDATABASE=threef

# --- warehouse database (a SEPARATE server, deliberately) -------------------
WAREHOUSE_PG_USER=warehouse
WAREHOUSE_PG_PASSWORD=change-me-too
WAREHOUSE_PG_DATABASE=warehouse

# --- assistant model --------------------------------------------------------
# Decision 0027 fixes Bedrock in ap-south-1. LLM_PROVIDER=mock will start, but
# the mock provider ALWAYS returns a clarification, so Ask will look broken.
LLM_PROVIDER=bedrock
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=

# Pick ONE of the three. Leave the others blank.
#  1. Bedrock API key (bearer token):
AWS_BEARER_TOKEN_BEDROCK=
#  2. Access keys. AWS_SESSION_TOKEN is required for temporary STS credentials:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
#  3. An IAM instance role - leave all of the above blank. The container is one
#     hop further from instance metadata than the host, so IMDSv2's default hop
#     limit of 1 blocks it. Raise it first:
#       aws ec2 modify-instance-metadata-options --instance-id i-XXXX \
#         --http-tokens required --http-put-response-hop-limit 2

# Who may sign in. Additive, but it REPLACES the default - keep the admin entry.
# SEED_USERS=admin@example.invalid|3F Admin|admin;you@example.com|Your Name|admin

# Signs the attested statement context behind the MIS assistant's explanations.
# REQUIRED - the backend refuses to start without it, on purpose: there is no
# development fallback, because a silently unsigned context would defeat the
# check it exists to make.
#
#   openssl rand -hex 32
#
# Several keys may be listed, separated by ";". The FIRST signs and ANY listed
# key verifies, so rotating is: put the new key first, keep the old one behind
# it, redeploy, and drop the old one once every open statement has expired.
STATEMENT_ATTESTATION_SECRETS=
# Optional. How long an issued statement context stays valid, in minutes.
# Default 30; accepted range 1-240.
STATEMENT_ATTESTATION_TTL_MINUTES=30
